# Copy to .env for local development. Never commit .env.

ENVIRONMENT=development

# Comma-separated list of allowed frontend origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_DB=climate_hazards
ANALYSIS_CACHE_TTL_DAYS=30

# One consistent reanalysis dataset for the whole period (see README)
OPEN_METEO_MODEL=era5

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2

RATE_LIMIT_ANALYSIS=30/minute
RATE_LIMIT_GEOCODE=60/minute
